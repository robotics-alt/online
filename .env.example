# Use absolute paths so the web and realtime processes share the same files.
DATABASE_URL="file:/absolute/path/to/online/db/production.db"
LOCAL_UPLOAD_ROOT="/absolute/path/to/online/uploads"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace-with-a-strong-random-secret-of-at-least-32-characters"
PORT=3000
APP_HOST=0.0.0.0
# Optional bootstrap only. Remove ADMIN_PASSWORD after running npm run admin:create.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrator"
